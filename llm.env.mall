# Kopieras till /etc/llm/llm.env av install.sh (rattigheter 600, agare root).
# Format: NYCKEL=varde, inga mellanslag runt =, raka "citattecken" bara runt
# varden med mellanslag, inga $-variabler eller kommandon (filen lases bade av
# bash och av en enkel Python-tolk, som ska ge samma resultat).

# Containerbild som tagg, t.ex. vllm/vllm-openai:qwen38 (bild.sh skriver ut raden)
LLM_IMAGE=

# Bildens id (sha256:...) fran bild.sh. Tomt = ingen kontroll.
# Id overlever docker save/load; en digest gor det inte.
LLM_IMAGE_ID=

# Katalognamn under /srv/models (inte hela sokvagen)
LLM_MODEL_DIR=

# Namnet klienterna anvander. Behall vid modellbyte.
LLM_NAME=kod

# Adress och port som API:et lyssnar pa. 127.0.0.1 = bara den har maskinen.
# Maskinens adress pa labbnatet (eller 0.0.0.0) = nabar fran andra maskiner;
# da ska natansvarig begransa porten. Bara /v1 kraver nyckel.
LLM_BIND=127.0.0.1
LLM_PORT=8000

# Programmet som startas i containern
LLM_ENTRYPOINT=vllm

# Extra flaggor till docker run, t.ex. "-e VLLM_PLE_SSD=1"
LLM_DOCKER_EXTRA=

# Fylls i automatiskt av install.sh. Skickas till containern som miljovariabel.
VLLM_API_KEY=
